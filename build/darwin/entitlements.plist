<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements. Tauri's bundler supplied these implicitly;
  Wails does not, so they are spelled out.

  JIT and unsigned-executable-memory are required by JavaScriptCore, which is
  what the macOS webview runs. Without them the window loads and then dies.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Outbound connections to database servers and map tiles. -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- Reading and writing SQLite files and exports the user chooses. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
</dict>
</plist>
