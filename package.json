{
  "name": "dodb",
  "version": "1.0.0",
  "productName": "dodb",
  "description": "dodb - Modern Multi-Platform Database Manager for Postgres, MySQL, MariaDB & SQLite",
  "main": "electron/main.js",
  "author": {
    "name": "thutil",
    "email": "thutil@users.noreply.github.com"
  },
  "scripts": {
    "start": "ts-node src/server.ts",
    "build": "pnpm build:backend && pnpm build:ui",
    "build:backend": "tsc",
    "build:ui": "pnpm --prefix ui build",
    "dev": "nodemon src/server.ts",
    "ui:dev": "pnpm --prefix ui dev",
    "desktop": "electron electron/main.js",
    "dist": "pnpm build && electron-builder --mac --publish never",
    "dist:mac": "pnpm build && electron-builder --mac --publish never"
  },
  "build": {
    "appId": "com.thutil.dodb",
    "productName": "dodb",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist-builds"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.png",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ],
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "dodb - Database Manager",
      "icon": "assets/icon.png",
      "contents": [
        {
          "x": 130,
          "y": 180,
          "type": "file"
        },
        {
          "x": 410,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 360
      }
    },
    "compression": "maximum",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "ui/out/**/*",
      "assets/**/*",
      "package.json",
      "!ui/node_modules/**/*",
      "!ui/src/**/*",
      "!ui/.next/**/*",
      "!src/**/*",
      "!data/**/*",
      "!dist-builds/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**/*"
    ]
  },
  "dependencies": {
    "@types/body-parser": "^1.19.6",
    "@types/pg": "^8.15.4",
    "better-sqlite3": "^13.0.3",
    "body-parser": "^2.2.0",
    "express": "^5.1.0",
    "mariadb": "^3.4.2",
    "pg": "^8.16.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.1",
    "@types/uuid": "^10.0.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}