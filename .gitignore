# Dependencies
node_modules/
ui/node_modules/

# Build and export outputs
dist/
dist-dmg/
dist-builds/
ui/.next/
# The bundle is generated, but one placeholder is committed so that
# //go:embed all:ui/out always matches -- see ui/out/.gitkeep.
ui/out/*
!ui/out/EMBED_PLACEHOLDER

# Environment and Data
.env
.env.local
data/
*.log

# OS and Editor files
.DS_Store
.vscode/
/website

# Go (dodb v0.3 port)
/dodb
/dodb-devserver
/spike
/bin/

# Generated from testdata/fixtures/sqlite.sql by `make fixtures-up`.
# A checked-in binary would drift from the schema beside it.
testdata/fixtures/fixture.sqlite

# Windows resource binaries
*.syso

