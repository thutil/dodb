{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "dodb",
  "version": "0.2.3",
  "identifier": "com.thutil.dodb",
  "build": {
    "frontendDist": "../ui/out",
    "devUrl": "http://localhost:5821",
    "beforeDevCommand": "pnpm ui:dev",
    "beforeBuildCommand": "pnpm build:ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "dodb",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
